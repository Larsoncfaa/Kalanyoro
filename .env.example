# =========================================================
# CONFIGURATION KALANYORO LMS
# =========================================================
# Copie ce fichier en .env et configure les valeurs
# IMPORTANT: Ne jamais commiter .env (contient des secrets)

# =========================================================
# DJANGO
# =========================================================

# Mode développement (True) ou production (False)
DJANGO_DEBUG=True

# Clé secrète Django (générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# ⚠️ EN PRODUCTION: Changer ABSOLUMENT cette valeur
DJANGO_SECRET_KEY=django-insecure-change-me-in-production

# Hosts autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - Autoriser all origins (dev only!)
CORS_ALLOW_ALL_ORIGINS=True

# =========================================================
# BASE DE DONNÉES
# =========================================================

# Type de base de données
DB_ENGINE=django.db.backends.postgresql

# Connexion PostgreSQL
DB_NAME=gestion_coran
DB_USER=coran_user
DB_PASSWORD=your-secure-password-here
DB_HOST=localhost
DB_PORT=5432

# Alternative: SQLite (local development)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# =========================================================
# SÉCURITÉ (Production)
# =========================================================

# HTTPS force (production)
SECURE_SSL_REDIRECT=False

# Cookies sécurisés
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=0

# =========================================================
# AUTHENTIFICATION
# =========================================================

# Durée de vie du token d'accès (en heures)
JWT_ACCESS_TOKEN_LIFETIME=12

# Durée de vie du token de rafraîchissement (en jours)
JWT_REFRESH_TOKEN_LIFETIME=7

# =========================================================
# EMAILS (Optionnel)
# =========================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# =========================================================
# LOGGING
# =========================================================

LOG_LEVEL=INFO
LOG_FILE=logs/darasa.log

# =========================================================
# CACHE (Redis optionnel)
# =========================================================

CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
REDIS_URL=redis://localhost:6379/0
